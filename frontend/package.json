    "axios": "^1.7.9",
    "dotenv": "^18.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.0.0",
